{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gt-four-part-two-frontend": {
      "root": "GT-4/GT4-Part2",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "gt-four-part-two-api": {
      "root": "GT-4/GT4-Part2/backend",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "outputDirectory": "."
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "gt-four-part-two-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "gt-four-part-two-frontend" }
    }
  ]
}